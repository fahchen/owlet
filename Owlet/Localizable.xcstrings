    "Learning content skips the languages you already speak; it does not change the language explanations are written in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning content skips the languages you already speak; it does not change the language explanations are written in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに習得している言語の表現は学習内容に含まれません。解説に使う言語は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习内容不包含你已经掌握的语言；它不改变释义所用的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "學習內容不包含你已經掌握的語言；它不改變釋義所用的語言。"
          }
        }
      }
    },
