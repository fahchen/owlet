    "%@ was not found. Choose its executable by hand, or install it and press Detect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was not found. Choose its executable by hand, or install it and press Detect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が見つかりません。実行ファイルを手動で選択するか、インストールして「検出」を押してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到 %@。请手动选择它的可执行文件，或安装后点「检测」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@。請手動選擇它的可執行檔，或安裝後按「偵測」。"
          }
        }
      }
    },
