    "返回的原文与提交的内容不一致，配对无法信任。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The returned source does not reassemble into what was submitted, so the pairing cannot be trusted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返された原文が送信した内容と一致しないため、対応関係を信頼できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回的原文与提交的内容不一致，配对无法信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳的原文與提交的內容不一致，配對無法信任。"
          }
        }
      }
    },
    "返回的目标语言是 %@，与请求的 %@ 不一致。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reply is in %@, which does not match the requested %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返された言語は %@ で、要求した %@ と一致しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回的目标语言是 %@，与请求的 %@ 不一致。"
