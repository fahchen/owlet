    "The source is detected from the text. The fallback is used when it cannot be detected or has no row; one source keeps one mapping.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source is detected from the text. The fallback is used when it cannot be detected or has no row; one source keeps one mapping."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原文から言語を自動判定します。判定できない場合や対応する行がない場合は既定の翻訳先を使います。1 つの言語につき対応は 1 つです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源语言由原文自动识别。未识别出源语言、或源语言没有对应行时使用兜底目标；一个源语言只保留一条映射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "源語言由原文自動識別。未識別出源語言、或源語言沒有對應列時使用兜底目標；一個源語言只保留一條映射。"
          }
        }
      }
    },
