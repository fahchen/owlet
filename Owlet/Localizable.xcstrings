        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳的目標語言是 %@，與請求的 %@ 不一致。"
          }
        }
      }
    },
    "返回的结构不符合约定：字段缺失、类型不对或内容为空。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reply does not match the agreed structure: a missing field, a wrong type, or empty content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返された構造が約束と一致しません：項目の欠落、型の不一致、または内容が空です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回的结构不符合约定：字段缺失、类型不对或内容为空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回傳的結構不符合約定：欄位缺失、型別不對或內容為空。"
          }
        }
      }
    },
