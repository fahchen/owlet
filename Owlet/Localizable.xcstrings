    "The API key is kept in the keychain, and applies when the field loses focus.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is kept in the keychain, and applies when the field loses focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key はキーチェーンに保存され、入力欄から離れたときに反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 存在钥匙串里；离开输入框后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 存在鑰匙圈裡；離開輸入框後生效。"
          }
        }
      }
    },
    "The agent uses its own sign-in, so no API key is needed here. Its tools, skills, project context and session files stay switched off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent uses its own sign-in, so no API key is needed here. Its tools, skills, project context and session files stay switched off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この agent は自身のサインインを使うため、ここに API キーは不要です。ツール、スキル、プロジェクトのコンテキスト、セッションファイルは無効のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 agent 使用自己的登录状态，因此这里不需要 API Key；它的工具、技能、项目上下文与会话文件都保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該 agent 使用自己的登入狀態，因此這裡不需要 API Key；它的工具、技能、專案內容與工作階段檔案都保持關閉。"
          }
        }
      }
    },
    "The content cannot be empty; this change was not applied.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
